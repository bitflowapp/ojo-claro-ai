APP_NAME=Ojo Claro AI
APP_ENV=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
IMAGE_RETENTION_SECONDS=0
ALLOW_MOCK_AI=false

# --- Estela Agent Core v1 ---
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_AGENT_MAX_OUTPUT_TOKENS=600
OPENAI_AGENT_TIMEOUT_SECONDS=20
OPENAI_AGENT_MAX_STEPS=8
OPENAI_AGENT_MAX_REPLANS=2
OPENAI_AGENT_MAX_DURATION_SECONDS=90

# --- Estela Outdoor Guidance v1 ---
# Proveedor de rutas peatonales: openrouteservice (default) | google.
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
# Solo si ROUTE_PROVIDER=google. Nunca en el APK.
GOOGLE_MAPS_API_KEY=
